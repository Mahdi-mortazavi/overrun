# Android signing material. The keystore and its base64 form are the one thing
# in this repository that can never be regenerated or rotated without breaking
# every install of the app — they belong in GitHub Secrets and in a password
# manager, never in a commit.
KEYSTORE_BASE64.txt
release.keystore
*.p12
local.properties

# Capacitor
packages/android/android/local.properties
packages/android/android/.idea/

# Local secrets, never committed
SECRETS.local.md
release.keystore
KEYSTORE_BASE64.txt

# Icons and screenshots ARE committed: the production build must not depend on
# Python and Pillow existing in the build container, and a manifest pointing at
# icons that were never generated makes the PWA uninstallable.
# tools/gen-icons.py remains the source of truth for regenerating them.
packages/android/android/app/src/main/res/mipmap-*/
packages/android/android/app/src/main/res/drawable-*/

# Fetched by CI; see .github/workflows/android.yml
packages/android/android/gradle/wrapper/gradle-wrapper.jar

# Chat delivery scratch
deliver/
