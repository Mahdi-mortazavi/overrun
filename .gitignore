# Android signing material. The keystore and its base64 form are the one thing
# in this repository that can never be regenerated or rotated without breaking
# every install of the app — they belong in GitHub Secrets and in a password
# manager, never in a commit.
KEYSTORE_BASE64.txt
release.keystore
*.p12
local.properties

