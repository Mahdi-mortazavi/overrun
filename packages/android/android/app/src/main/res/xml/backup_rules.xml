<?xml version="1.0" encoding="utf-8"?>
<!-- Progress lives in the WebView's localStorage; back it up, nothing else. -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="file" path="app_webview" />
    <exclude domain="file" path="app_webview/Default/Cache" />
</full-backup-content>
